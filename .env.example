HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
GAME_PUBLIC_HOST=127.0.0.1
GAME_PORT_START=8201
GAME_PORT_END=8299
DATA_DIR=.data
# Set a unique password with at least 12 characters. Never commit .env.
