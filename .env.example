HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
GAME_PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8200
DATA_DIR=.data
# Set a unique password with at least 12 characters. Never commit .env.
ADMIN_PASSWORD=
BUILD_TIMEOUT_MINUTES=20
# Set true only behind an HTTPS reverse proxy; PUBLIC_URL must use https.
COOKIE_SECURE=false

# Android builds: use installed JDK 17 and Android SDK absolute paths.
# JAVA_HOME=/opt/java/openjdk
# ANDROID_HOME=/opt/android-sdk
# GRADLE_USER_HOME=/home/publishing/.gradle
