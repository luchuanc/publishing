{
  "name": "publishing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "check": "node --check server/app.mjs && node --check server/service.mjs && node --check server/runner.mjs && node --check server/android.mjs && node --check server/public.mjs && node --check server/legacy.mjs && node --check server/storage.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.3"
  }
}
